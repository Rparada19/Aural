{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@aural/shared": [
        "../../packages/shared/src"
      ],
      "@aural/shared/*": [
        "../../packages/shared/src/*"
      ]
    },
    "types": [
      "node",
      "react"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../packages/shared/src/**/*"
  ]
}
