{
  "expo": {
    "name": "Aural",
    "slug": "aural",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "aural",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.aural.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "co.aural.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#041E42",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-asset",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Gotham-Light.ttf",
            "./assets/fonts/Gotham-Book.ttf",
            "./assets/fonts/Gotham-Medium.ttf",
            "./assets/fonts/Gotham-Bold.ttf",
            "./assets/fonts/Gotham-Black.ttf"
          ]
        }
      ],
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f742f4a9-4feb-4fde-963e-35639d5356c6"
      }
    },
    "owner": "rafa1991"
  }
}
